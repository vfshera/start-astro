---
import "~/styles/global.css";
import { SEO, type Props as AstroSEOProps } from "astro-seo";
import { site } from "~/constants/config";
import { createStructuredData } from "~/lib/structured-data";
import type { StructuredData } from "~/types";

interface Props extends AstroSEOProps {
  /**
   * Applied to html body
   */
  class?: astroHTML.JSX.HTMLAttributes["class"];
  /**
   * Applied to html body
   */
  "class:list"?: astroHTML.JSX.HTMLAttributes["class:list"];
  /**
   * Language of the document
   */
  lang?: string;
  structuredData?: StructuredData[] | false;
}

const {
  title,
  description,
  class: className,
  "class:list": classList,
  lang = "en",
  structuredData: givenData,
  ...props
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site!);

const structuredData = createStructuredData({
  name: title || site.title,
  url: canonical,
  data: givenData || [],
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <SEO
      title={title}
      titleDefault={site.title}
      titleTemplate={`%s - ${site.title}`}
      description={description || site.description}
      {...props}
    />
    {
      givenData != false && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
    <slot name="head" />
  </head>
  <body class:list={[classList, className]}>
    <slot />
  </body>
</html>
